# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# IDE and OS files
.DS_Store
.idea/
.vscode/

# Notebook checkpoints
.ipynb_checkpoints/

# Logs
*.log

# Build and packaging outputs
build/
dist/
*.egg-info/

# Project outputs
results/*
!results/.gitkeep

reports/figures/*
!reports/figures/.gitkeep

# Derived data directories
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

data/interim/*
!data/interim/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/cleaned/*
!data/cleaned/.gitkeep

data/external/*
!data/external/.gitkeep

